OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBED_MODEL=text-embedding-3-small

# Optional. Used by Docker Compose for Postgres (defaults to zpm if unset).
# Set a strong value on Lightsail before the first start.
POSTGRES_PASSWORD=zpm

# Host-only / local API against published Postgres (port 5433).
# Compose sets DATABASE_URL to the internal postgres service for containers.
DATABASE_URL=postgresql://zpm:zpm@localhost:5433/zpm
